{
  "manifest_version": 3,
  "name": "MoonDigest · 月团视频摘读",
  "version": "3.6.1",
  "description": "用 AI 读 B站、YouTube 视频和网页：AI 总结、问答；整理收藏夹，判断哪些值得留；整理关注的 UP 主。笔记可导出 Markdown，也可写入 Obsidian。",

  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "sidePanel", "cookies", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/list/watchlater",
        "https://www.bilibili.com/list/watchlater/*",
        "https://www.youtube.com/*"
      ],
      "js": ["common.js", "errors.js", "limits.js", "typing.js", "settings.js", "sites.js", "tag-core.js", "note.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["common.js", "errors.js", "limits.js", "typing.js", "settings.js", "sites.js", "tag-core.js", "note.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://space.bilibili.com/*"],
      "js": ["common.js", "typing.js", "triage/viewer-frame.js"],
      "css": ["triage/viewer-frame.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://t.bilibili.com/*"
      ],
      "js": ["common.js", "errors.js", "limits.js", "typing.js", "settings.js", "tag-core.js", "bili-surfaces.js", "badges.js"],
      "css": ["badges.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["badges.css"],
      "matches": ["https://www.bilibili.com/*"],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_title": "MoonDigest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
